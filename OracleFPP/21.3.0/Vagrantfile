require 'yaml'
require 'ipaddr'
require 'shellwords'
require 'digest'

VAGRANTFILE_API_VERSION = '2'

# ----------------------- Shared Oracle software repository -------------------
# Large Oracle installer zips are stored once in a central repo shared by every
# lab under the Vagrant root, instead of being duplicated into each project's
# ORCL_software/. Override the location with the ORCL_SOFTWARE_REPO env var.
SOFTWARE_REPO = ENV.fetch('ORCL_SOFTWARE_REPO', File.expand_path('../../_ORCL_software', __dir__))

# Resolve an installer zip to an absolute host path: prefer the shared repo,
# fall back to this project's ORCL_software/ (which still works and overrides
# the shared copy). Returns the local path when neither exists so the caller's
# existence check still prints the usual "place the zip here" guidance.
def sw_zip(name)
  return nil if name.nil? || name.to_s.strip.empty?
  central = File.join(SOFTWARE_REPO, name)
  local   = File.join(__dir__, 'ORCL_software', name)
  File.exist?(central) ? central : local
end

