# ==============================================================================
# Oracle FPP (Fleet Patching and Provisioning) — 21c (21.3.0)
# on Oracle Linux 8
# ==============================================================================
#
# Copy this file to vagrant.yml and edit. vagrant.yml is gitignored so your
# local credentials stay out of source control.
#
#     cp config/vagrant.yml.example config/vagrant.yml
#
# Only one provider block should be active at a time — the one matching
# `env.provider`.
#
# CREDENTIALS
#   The defaults below are DISTINCT placeholders, not a real password policy.
#   Replace them before any real use. Every password can also be supplied at
#   run time via an environment variable, which overrides the YAML value:
#
#       ORACLE_ROOT_PASSWORD    (overrides root_password)
#       ORACLE_GRID_PASSWORD    (overrides grid_password)
#       ORACLE_ORACLE_PASSWORD  (overrides oracle_password)
#       ORACLE_SYS_PASSWORD     (overrides sys_password)
#
#   Never commit a vagrant.yml that contains real credentials.
#
# ------------------------------------------------------------------------------

# -------------------------------- Active profile -------------------------------
# -----------------------------------------------
# vagrant.yml for VirtualBox
# -----------------------------------------------
vm1:
  vm_name: fpps
  mem_size: 16384
  cpus: 1
  public_ip:     192.168.56.111
  vip_ip:        192.168.56.113
  scan_ip1:      192.168.56.114
  scan_ip2:      192.168.56.115
  scan_ip3:      192.168.56.116
  gns_ip:        192.168.56.117
  ha_vip:        192.168.56.118
  private_ip:    192.168.200.111
  u01_disk: ./fpps_u01.vdi

vm2:
  vm_name: fppc
  mem_size: 8192
  cpus: 4
  public_ip: 192.168.56.112
  private_ip: 192.168.200.112
  u01_disk: ./fppc_u01.vdi
  deploy: 'false'

shared:
  prefix_name:   fpp213-ol8
  # ---------------------------------------------
  network:       hostonly
  netmask:       
  gateway:       
  dns_public_ip: 
  domain:        localdomain
  # ---------------------------------------------
  non_rotational: 'on'
  # ---------------------------------------------
  asm_disk_path: 
  asm_disk_num:  4
  asm_disk_size: 50
  # ---------------------------------------------

env:
  provider: virtualbox
  # ---------------------------------------------
  gi_software: LINUX.X64_213000_grid_home.zip
  db_software: LINUX.X64_213000_db_home.zip

  # Optional Release Update. Patching is opt-in: set BOTH keys to patch the GI
  # and RDBMS homes, or leave both out to install at base release. The GI RU is
  # a combo patch that carries the RDBMS home patch too, so there is no separate
  # Database RU. Each zip needs an entry in db_installer.sha256.
  #opatch_software: p6880880_210000_Linux-x86-64.zip
  #gi_ru_software:  p<bug-number>_210000_Linux-x86-64.zip
  # ---------------------------------------------
  root_password:   welcome1
  grid_password:   welcome1
  oracle_password: welcome1
  sys_password:    welcome1
  # ---------------------------------------------
  ora_languages:   en,en_GB
  # ---------------------------------------------


