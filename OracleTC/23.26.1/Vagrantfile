var_sga_target      = params['env']['sga_target']

# -----------------------------------------------------------------
# Provider Specific checks
# -----------------------------------------------------------------
if ( (var_provider_name != 'libvirt') and (var_provider_name != 'virtualbox') )
  puts "ERROR: 'provider' option can be 'libvirt' or 'virtualbox'" 
  exit
else
  provider = (var_provider_name).to_sym
  puts "--------------------"
  puts "Detected #{provider}"
  puts "--------------------"
end

# Base Settings
if var_provider_name == 'virtualbox'
  box_disks_num = 1
  ENV['VAGRANT_DEFAULT_PROVIDER'] || 'virtualbox'
  var_vm1_name = var_prefix_name + "-" + var_vm1_name
elsif var_provider_name == 'libvirt'
  box_disks_num = 1
  ENV['VAGRANT_DEFAULT_PROVIDER'] || 'libvirt'
  ENV['VAGRANT_NO_PARALLEL'] = 'yes'
else 
  puts "Not supported #{provider}, exiting..."
  exit
end

## Storage Setup
if var_provider_name == 'libvirt'
  var_vm1_storage     = params['host1']['storage_pool_name']
  var_oradata_storage = params['env']['storage_pool_name']

  if var_vm1_storage.to_s.empty?
    var_vm1_storage = "default"
  end
  if var_oradata_storage.to_s.empty?
    var_oradata_storage = "default"
  end
end
if var_provider_name == 'virtualbox'
  var_group           = "/" + var_prefix_name
  var_vm1_u01_disk       = params['host1']['u01_disk']
  var_non_rotational     = params['env']['non_rotational']
  var_oradata_disk_path  = params['env']['oradata_disk_path']

  if ( (var_non_rotational != 'on') and (var_non_rotational != 'off') )
    puts 'ERROR: non_rotational option can be on or off'
    exit
  end
  if var_oradata_disk_path.to_s.empty?
    var_oradata_disk_path = "./"
  else
    var_oradata_disk_path = var_oradata_disk_path + "/"
  end
  if var_vm1_u01_disk.to_s.empty?
    var_vm1_u01_disk = "./primary_u01.vdi"
  end
end

# -----------------------------------------------------------------
# Variables check
# -----------------------------------------------------------------
class String
  def is_ip?
    !!IPAddr.new(self) rescue false
  end
end

if !var_prefix_name.match? /\A[0-9a-zA-Z-]{1,14}\z/
  puts 'ERROR: prefix_name \'' + var_prefix_name + '\' option can be any combination'
  puts '  {1..13 chars} of lower and uppercase alphanumeric characters (a - z, A - Z, 0 - 9), and hyphen(-)'
  exit
end

if var_vm1_mem_size.to_i < 6144
  puts 'ERROR: vm1_mem_size option can not be less then 6 Gb'
  exit
end

if var_sga_target.to_s.empty?
  var_sga_target = var_vm1_mem_size * 70 / 100
end
var_hugepages = ((var_sga_target) * 1024 / 2048 * 1.05).to_i


if var_oradata_disk_size.to_i < 10
  puts 'ERROR: asm_disk_size option can not be less then 10 Gb'
  exit
end

if ( (var_network != 'hostonly') and (var_network != 'public') )
  puts "ERROR: network option can be 'public' or 'hostonly'"
  exit
end
if (var_provider_name == 'libvirt')
  if ( (var_network == 'public') and (var_bridge_nic.to_s.empty?))
    puts "ERROR: bridge_nic is empty"
    exit
  end
end

if var_network == 'public'
  if var_gateway.to_s.empty?
   puts "ERROR: Using public network gateway must be defined"
   exit
  end
  if var_netmask.to_s.empty?
    puts "ERROR: Using public network netmask must be defined"
    exit
  end
  if var_dns_public_ip.to_s.empty?
    puts "ERROR: Using public network var_dns_public_ip must be defined"
    exit
  end

  if ! var_netmask.is_ip?
    puts "ERROR: netmask is not a valid IP address"
    exit
  end
  if ! var_gateway.is_ip?
    puts "ERROR: gateway is not a valid IP address"
    exit
  end
  if ! var_dns_public_ip.is_ip?
    puts "ERROR: var_dns_public_ip is not a valid IP address"
    exit
  end
end

if ! var_vm1_public_ip.is_ip?
  puts 'ERROR: public_ip for host1 is not a valid IP address'
  exit
end
if ! var_vm1_private_ip.is_ip?
  puts 'ERROR: private_ip for host1 is not a valid IP address'
  exit
end

if var_root_password.to_s.empty?
 puts "ERROR: root_password is not defined"
 exit
end
if var_oracle_password.to_s.empty?
 puts "ERROR: oracle_password is not defined"
 exit 
end

unless var_db_software.start_with?(EXPECTED_DB_SOFTWARE_PREFIX)
  puts "ERROR: db_software (#{var_db_software}) does not match this project (expected prefix: #{EXPECTED_DB_SOFTWARE_PREFIX})"
  exit
end

checksum_path = File.expand_path('./db_installer.sha256', __dir__)
zip_path      = sw_zip(var_db_software)

# Verify the base installer against the manifest (sha256 + readable-zip), not
# just that the file exists — fail fast, before any VM boots.
unless File.exist?(zip_path)
  puts "ERROR: db_software does not exist: #{zip_path}"
  puts "  Place the Oracle Database #{EXPECTED_DB_SOFTWARE_PREFIX[/\d+/]}* zip into ORCL_software/."
  exit
end
unless File.exist?(checksum_path)
  puts "ERROR: installer checksum file not found: #{checksum_path}"
  exit
end
verify_installer!(checksum_path, zip_path, var_db_software, 'base installer')

# Both RU zips or neither: the opatch shipped inside the home is too old to apply
# a modern RU, so a half-configured pair is a mistake worth failing on.
if var_opatch_software.empty? ^ var_db_ru_software.empty?
  puts "ERROR: 'env.opatch_software' and 'env.db_ru_software' must be set together " \
       "(opatch_software: '#{var_opatch_software}', db_ru_software: '#{var_db_ru_software}')"
  exit
end

# The RU pair is optional, but once configured it gets the same treatment as the
# base installer: present on disk, and pinned in the checksum manifest.
[var_opatch_software, var_db_ru_software].reject(&:empty?).each do |ru_zip|
  ru_zip_path = sw_zip(ru_zip)
  unless File.exist?(ru_zip_path)
    puts "ERROR: patch zip not found: #{ru_zip_path}"
    puts "  Place it into ORCL_software/, or remove 'env.opatch_software' and " \
         "'env.db_ru_software' to install at base release."
    exit
  end
  verify_installer!(checksum_path, ru_zip_path, ru_zip, 'patch')
end

# The source-DB password file must be staged under SDB_files/ before boot: the
# True Cache instance copies it into the home as orapw<instance_name>. Check on
# the HOST so a missing file fails fast, instead of after the full OS + software
# install (08_TrueCache_setup.sh would otherwise error near the very end).
sdb_pwfiles = Dir.glob(File.expand_path('./SDB_files/orapw*', __dir__))
if sdb_pwfiles.empty?
  puts "ERROR: no source-DB password file found under SDB_files/ (expected orapw<SID>)"
  puts "  Copy the source database password file into SDB_files/ before 'vagrant up'"
  puts "  (it is staged on the True Cache node as orapw#{var_instance_name})."
  exit
end


if var_oradata_disk_num.to_i < 2
  puts 'ERROR: oradata_disk_num option can not be less then 2'
  exit
end


if var_sdb_host_name.to_s.empty?
 puts "ERROR: sdb_host_name is not defined"
 exit
end
if var_sdb_service_name.to_s.empty?
 puts "ERROR: sdb_service_name is not defined"
 exit
end

if var_sdb_service_port.to_s.empty?
  var_sdb_service_port = 1521
end
if var_db_files.to_s.empty?
  var_db_files = 200
end

if var_db_unique_name.to_s.empty?
 puts "ERROR: db_unique_name is not defined"
 exit
end
if var_instance_name.to_s.empty?
 puts "ERROR: instance_name is not defined"
 exit
end

if var_instance_name.to_s.empty?
 puts "ERROR: instance_name is not defined"
 exit
end

if var_fal_server.to_s.empty?
  var_fal_server = var_sdb_service_name
end

if var_fal_client.to_s.empty?
  var_fal_client = var_db_unique_name
end
if var_local_listener.to_s.empty?
  var_local_listener = var_db_unique_name
end

