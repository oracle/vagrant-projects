# ==============================================================================
# Oracle Data Guard — Oracle Database 21c (21.3.0) on Oracle Linux 8
# ==============================================================================
#
# This file drives the Vagrantfile. Uncomment the block for the provider you
# intend to use (virtualbox OR libvirt) and comment the other out.
#
# IMPORTANT:
#   * Default passwords are DEMO ONLY. Replace them before any real use.
#   * Never commit a vagrant.yml that contains real credentials.
#
# ------------------------------------------------------------------------------

# -------------------------------- VirtualBox ----------------------------------
vm1:
  vm_name:    primary
  mem_size:   8192          # MB — minimum 6144
  cpus:       2
  public_ip:  192.168.56.141
  private_ip: 192.168.200.141
  u01_disk:   ./primary_u01.vdi

vm2:
  vm_name:    standby
  mem_size:   8192
  cpus:       2
  public_ip:  192.168.56.142
  private_ip: 192.168.200.142
  u01_disk:   ./standby_u01.vdi

env:
  provider:          virtualbox
  prefix_name:       dg21-ol8
  domain:            localdomain

  # Oradata disks
  non_rotational:    'on'
  oradata_disk_path: ''           # empty = project directory
  oradata_disk_num:  2
  oradata_disk_size: 20           # GB per disk

  # Oracle Database 21c (21.3.0) base installer — Enterprise Edition.
  # Download from: https://www.oracle.com/database/technologies/oracle-database-software-downloads.html
  db_software:       LINUX.X64_213000_db_home.zip

  # Optional Database Release Update. Patching is opt-in: set BOTH keys to patch
  # the RDBMS home before the database is created (applied on primary AND standby
  # so they start at the same patch level), or leave both out to install at base
  # release. Each zip needs an entry in db_installer.sha256.
  #opatch_software:   p6880880_210000_Linux-x86-64.zip
  #db_ru_software:    p<bug-number>_210000_Linux-x86-64.zip

  # Credentials — CHANGE THESE BEFORE REAL USE.
  root_password:     welcome1
  oracle_password:   welcome1
  sys_password:      welcome1
  pdb_password:      welcome1

  ora_languages:     en,en_GB

  db_name:           DB21H1
  pdb_name:          PDB1
  cdb:               true
  adg:               true        # Active Data Guard (open R/O + apply)

