# ==============================================================================
# Oracle Standard Edition High Availability (SEHA)
# Oracle Database 23ai (23.26.1) on Oracle Linux 9
# ==============================================================================
#
# Copy this file to vagrant.yml and edit. vagrant.yml is gitignored so your
# local credentials stay out of source control.
#
#     cp config/vagrant.yml.example config/vagrant.yml
#
# Only one provider block should be active at a time: the one matching
# env.provider.
#
# Credentials
#   The defaults below are demo placeholders. Replace them before any real use.
#   Every password can also be supplied at run time via an environment variable,
#   which overrides the YAML value:
#
#       ORACLE_SEHA_ROOT_PASSWORD    (overrides root_password)
#       ORACLE_SEHA_GRID_PASSWORD    (overrides grid_password)
#       ORACLE_SEHA_ORACLE_PASSWORD  (overrides oracle_password)
#       ORACLE_SEHA_SYS_PASSWORD     (overrides sys_password)
#       ORACLE_SEHA_PDB_PASSWORD     (overrides pdb_password)
#
#   Never commit a vagrant.yml that contains real credentials.
#
# ------------------------------------------------------------------------------

## -------------------------------- Active profile -------------------------------
host1:
  vm_name:    node1
  mem_size:   8192            # MB, minimum 6144
  cpus:       4
  public_ip:  192.168.56.111
  vip_ip:     192.168.56.112
  private_ip: 192.168.200.111
  storage_pool_name: Vagrant_KVM_Storage

host2:
  vm_name:    node2
  mem_size:   8192            # MB, minimum 6144
  cpus:       4
  public_ip:  192.168.56.121
  vip_ip:     192.168.56.122
  private_ip: 192.168.200.122
  storage_pool_name: Vagrant_KVM_Storage

env:
  provider:          virtualbox
  prefix_name:       seha26-ol9
  domain:            localdomain

  # SCAN addresses: three IPs in the same subnet as public_ip.
  scan_ip1:          192.168.56.115
  scan_ip2:          192.168.56.116
  scan_ip3:          192.168.56.117

  # Shared ASM disks. P1 backs DATA; P2 backs RECO.
  asm_disk_path:
  asm_disk_num:      4          # minimum 4
  asm_disk_size:     20         # GB per disk
  p1_ratio:          80         # P1 size ratio, 10..80
  storage_pool_name: Vagrant_KVM_Storage

  # Oracle Database 23ai (23.26.1) Grid Infrastructure and RDBMS installers.
  # Download from:
  #   https://www.oracle.com/database/technologies/oracle-database-free-downloads.html
  gi_software:       LINUX.X64_2326100_grid_home.zip
  db_software:       LINUX.X64_2326100_db_home.zip

  # Optional Release Update. 23.26.1 already ships SEHA, so patching is opt-in:
  # set BOTH keys to patch the GI and DB homes, or leave both out to install at
  # base release. Each zip needs an entry in db_installer.sha256.
  #opatch_software:   p6880880_230000_Linux-x86-64.zip
  #gi_ru_software:    p<bug-number>_230000_Linux-x86-64.zip

  # Credentials: demo placeholders only.
  root_password:     DemoRoot_1
  grid_password:     DemoGrid_1
  oracle_password:   DemoOra_1
  sys_password:      DemoSys_1
  pdb_password:      DemoPdb_1

  ora_languages:     en,en_GB

  # SEHA layout is fixed:
  # this project always builds a two-node GI cluster with a SEHA database.
  # The DB home is installed as SE2, which SEHA requires.
  db_recovery_file_dest_size: 4G
  db_name:           SEHA26
  pdb_name:          PDB1

